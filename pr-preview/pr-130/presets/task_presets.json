  {
    "name": "FIND VICTOR AND ZELLEN",
    "description": "Track down Victor and Zellen across the city within a four-tick window.",
    "requirements": [],
    "attributes": [
      "trait:urban",
      "trait:stealth"
    ],
    "duration": { "kind": "fixed", "ticks": 4 },
    "operators": [
      {
        "id": "stealth",
        "kind": "gate",
        "quantifier": "all",
        "expr": "d20 + {skill:stealth}",
        "compare": { "op": ">=", "value": "11" }
      },
      {
        "id": "investigate",
        "kind": "gate",
        "quantifier": "any",
        "expr": "d20 + {skill:investigation}",
        "compare": { "op": ">=", "value": "24" }
      },
      {
        "id": "progress",
        "kind": "contribute",
        "target": "found",
        "expr": "1"
      }
    ],
    "vessels": {
      "found": { "name": "FOUND", "fullWhen": ">= 4" }
    },
    "effects": [
      {
        "on": "completion",
        "actions": [
          { "kind": "bank.adjust", "params": { "amount": 50 } }
        ]
      }
    ]
  },
